pipeline{
  agent any
  tools {
        maven 'Maven'
    }
      parameters{
              choice(
                    name : 'ENV',
                    choices : ['qa','uat','prod'],
                    description: 'Select Environment'
              )
              choice(
                    name : 'BROWSER',
                    choices : ['chrome','firefox'],
                    description: 'Select Browser'
              )
      }
      stages{
            stage('Run Smoke suite'){
                steps{
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        dir('ERP_Dollibarr2') {
                            bat "mvn clean test -Denv=${params.ENV} -Dbrowser=${params.BROWSER} -DsuiteXmlFile=batchExecution.xml"
                        }
                    }           
                }
            }
            stage('Publish Extent Report') {

            steps {

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'ERP_Dollibarr2/AdvanceRepots',
                    reportFiles: '*.html',
                    reportName: 'Automation Report'
                ])
            }
        }
      }
      post {
        success {
            emailext(
            subject: "SUCCESS : ${JOB_NAME} #${BUILD_NUMBER}",
            body: """
                Execution Completed
                Job Name    : ${JOB_NAME}
                Build No    : ${BUILD_NUMBER}
                Environment : ${params.ENV}
                Browser     : ${params.BROWSER}
                
                Build URL:
                ${BUILD_URL}
                """,
            attachmentsPattern: 'ERP_Dollibarr2/AdvanceRepots/*.html',
            to: 'hinduhistory1932@gmail.com'
          )
        }

        failure {
          emailext(
            subject: "FAILURE : ${JOB_NAME} #${BUILD_NUMBER}",
            body: """
                Execution Failed
                Job Name    : ${JOB_NAME}
                Build No    : ${BUILD_NUMBER}
                Environment : ${params.ENV}
                Browser     : ${params.BROWSER}
                
                Build URL:
                ${BUILD_URL}
                """,
            attachmentsPattern: 'ERP_Dollibarr2/AdvanceRepots/*.html',
            to: 'hinduhistory1932@gmail.com'
          )
        }
    }
}
